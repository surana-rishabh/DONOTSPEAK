# -----------------------------------------------------------------------------
# DO NOT SAY IT — local configuration
# Copy this file to .env, paste the two required keys, then run npm run check:env
# Never commit .env. It is already ignored by Git.
# -----------------------------------------------------------------------------

# REQUIRED: Google AI Studio key with access to Gemma 4 through the Gemini API.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TURN_TIMEOUT_MS=12000

# REQUIRED for voice: ElevenLabs key with Scribe, TTS and voice metadata access.
ELEVENLABS_API_KEY=
ELEVENLABS_CALLER_VOICE_ID=
ELEVENLABS_MIMIC_VOICE_ID=
ELEVENLABS_OPERATOR_VOICE_ID=

# OPTIONAL: blank selects an available voice labelled female by ElevenLabs.
ELEVENLABS_FEMALE_VOICE_ID=
# Legacy preference; only accepted if female.
ELEVENLABS_VOICE_ID=

ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# OPTIONAL: replace hosted Gemma with an OpenAI-compatible multimodal endpoint.
# When GEMMA_BASE_URL is set, GEMINI_API_KEY is not used by the world compiler.
GEMMA_BASE_URL=
GEMMA_LOCAL_MODEL=gemma3:4b
GEMMA_LOCAL_API_KEY=

# Local Express server.
PORT=8080
HOST=127.0.0.1
